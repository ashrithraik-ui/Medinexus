# Copy backend/.env.example to backend/.env
# Frontend uses the Vite proxy in development (no extra env required).

# backend/.env
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
DATABASE_URL="file:./dev.db"
GREEN_CORRIDOR_APPROACH_METERS=350
GREEN_CORRIDOR_CLEAR_METERS=40
DEMO_MODE=true
