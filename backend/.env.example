PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=lifeline360-hackathon-demo-secret-change-me
JWT_EXPIRES_IN=12h
DATABASE_URL="file:./dev.db"
MONGODB_URI="mongodb://127.0.0.1:27017/lifeline360"
GREEN_CORRIDOR_APPROACH_METERS=350
GREEN_CORRIDOR_CLEAR_METERS=40
DEMO_MODE=true

# Real SMTP Email Configuration (for sending real OTPs to driver email)
# For Gmail: Enter your Gmail address & 16-character App Password (from Google Account Security -> 2-Step Verification -> App Passwords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
